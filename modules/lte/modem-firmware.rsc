# =============================================================================
# routeros-gitops :: modules/lte/modem-firmware.rsc — OPTIONAL. GENERATED by modules/lte/build.py
# from modules/lte/modem-firmware.src — edit the .src, then rebuild. Docs: docs/09-modem-firmware.md
#
# Weekly LTE modem firmware check (and upgrade in mode=auto) for every enabled lte interface.
# Not the RouterBOARD firmware (engine/10-maintenance.rsc does that).
#
# SETTINGS (secrets.map, override per site)
#   PLACEHOLDER_MODEM_FW_MODE         notify | auto      notify = only report a newer version
#   PLACEHOLDER_MODEM_FW_START_DATE   first run date     its weekday is the weekly run day
#   PLACEHOLDER_MODEM_FW_START_TIME   run time           keep it after the nightly maintenance window
#   PLACEHOLDER_MODEM_FW_PING_TARGET  reachability check after the upgrade
#
# FLOW per modem: skip if uptime < 1h, deploy flag present, or interface not running
#   -> firmware-upgrade check (installed vs latest) -> current | available (notify) |
#   upgrade (auto): event first (LTE drops), wait up to 15 min for link + ping,
#   else disable/enable the interface, else ONE reboot. No reboot loop: the script
#   only runs from its weekly scheduler, never at startup.
# EVENTS (via script_LOG_EVENT): modem_fw_current, modem_fw_available, modem_fw_skip,
#   modem_fw_unsupported, modem_fw_upgrade_start, modem_fw_upgraded, modem_fw_failed,
#   modem_fw_recovery, modem_fw_recovery_reboot
# Requires script_LOG_EVENT (engine/00-observability.rsc or a site equivalent).
# Remove: /system scheduler remove [find comment="modem firmware (LTE)"]; /system script remove [find comment="modem firmware (LTE)"]
# =============================================================================
/system scheduler remove [find comment="modem firmware (LTE)"]
/system script remove [find comment="modem firmware (LTE)"]
/system script add name=script_MODEM_FW comment="modem firmware (LTE)" owner=admin dont-require-permissions=yes policy=ftp,reboot,read,write,policy,test,sensitive source=":local mode \"PLACEHOLDER_MODEM_FW_MODE\"\n:if (\$mode ~ \"^PLACEHOLDER_\") do={ :set mode \"notify\" }\n:local target \"PLACEHOLDER_MODEM_FW_PING_TARGET\"\n:if (\$target ~ \"^PLACEHOLDER_\") do={ :set target \"1.1.1.1\" }\n:local waitMax 900\n:local send do={\n  :global logEvent; :global logLevel; :global logMessage\n  :set logEvent \$e; :set logLevel \$l; :set logMessage \$m\n  :log info (\"MODEM_FW \" . \$e . \": \" . \$m)\n  :do { /system script run script_LOG_EVENT } on-error={ :log warning \"MODEM_FW: script_LOG_EVENT failed\" }\n}\n:local fwGet do={\n  :local r \"\"\n  :do { :local f [/interface lte firmware-upgrade \$i as-value]; :set r ([:tostr (\$f->\"installed\")] . \"|\" . [:tostr (\$f->\"latest\")]) } on-error={ :set r \"\" }\n  :return \$r\n}\n:local linkOk do={\n  :local up false\n  :do { :set up [/interface get [find name=\$i] running] } on-error={}\n  :if (\$up) do={ :if ([/ping \$t count=3] > 0) do={ :return true } }\n  :return false\n}\n:if ([/system resource get uptime] < 1h) do={ \$send e=\"modem_fw_skip\" l=\"info\" m=\"uptime below 1h (nightly maintenance just ran)\"; :error \"MODEM_FW: skipped\" }\n:if ([:len [/file find name~\"deploy-in-progress\"]] > 0) do={ \$send e=\"modem_fw_skip\" l=\"info\" m=\"deploy in progress\"; :error \"MODEM_FW: skipped\" }\n:foreach id in=[/interface lte find where disabled=no] do={\n  :local lif [/interface get \$id name]\n  :local go true\n  :if (![/interface get \$id running]) do={ \$send e=\"modem_fw_skip\" l=\"info\" m=(\$lif . \": interface not running (no SIM / no signal)\"); :set go false }\n  :local fw \"\"\n  :if (\$go) do={\n    :set fw [\$fwGet i=\$lif]\n    :if ([:len \$fw] = 0) do={ \$send e=\"modem_fw_unsupported\" l=\"warning\" m=(\$lif . \": firmware-upgrade check failed (modem not supported or server unreachable)\"); :set go false }\n  }\n  :local inst \"\"; :local latest \"\"\n  :if (\$go) do={\n    :local p [:find \$fw \"|\"]\n    :set inst [:pick \$fw 0 \$p]; :set latest [:pick \$fw (\$p + 1) [:len \$fw]]\n    :if (([:len \$latest] = 0) or (\$latest = \$inst)) do={ \$send e=\"modem_fw_current\" l=\"info\" m=(\$lif . \": \" . \$inst); :set go false }\n  }\n  :if (\$go and (\$mode != \"auto\")) do={ \$send e=\"modem_fw_available\" l=\"warning\" m=(\$lif . \": \" . \$inst . \" -> \" . \$latest . \" (notify mode, not installed)\"); :set go false }\n  :if (\$go) do={\n    \$send e=\"modem_fw_upgrade_start\" l=\"warning\" m=(\$lif . \": \" . \$inst . \" -> \" . \$latest . \", LTE will drop for a few minutes\")\n    :delay 5s\n    :do { /interface lte firmware-upgrade \$lif upgrade=yes } on-error={ :log warning (\"MODEM_FW: upgrade command returned an error on \" . \$lif) }\n    :delay 60s\n    :local back false\n    :local waited 60\n    :while ((!\$back) and (\$waited < \$waitMax)) do={\n      :if ([\$linkOk i=\$lif t=\$target]) do={ :set back true } else={ :delay 30s; :set waited (\$waited + 30) }\n    }\n    :if (!\$back) do={\n      \$send e=\"modem_fw_recovery\" l=\"critical\" m=(\$lif . \": no LTE \" . \$waitMax . \"s after upgrade, disable/enable interface\")\n      :do { /interface disable [find name=\$lif]; :delay 10s; /interface enable [find name=\$lif] } on-error={}\n      :delay 300s\n      :if ([\$linkOk i=\$lif t=\$target]) do={ :set back true }\n    }\n    :if (\$back) do={\n      :local after [\$fwGet i=\$lif]\n      :local now [:pick \$after 0 [:find \$after \"|\"]]\n      :if ((\$now != \$inst) and ([:len \$now] > 0)) do={ \$send e=\"modem_fw_upgraded\" l=\"info\" m=(\$lif . \": \" . \$inst . \" -> \" . \$now) } else={ \$send e=\"modem_fw_failed\" l=\"warning\" m=(\$lif . \": LTE back but firmware still \" . \$inst . \" (reported \" . \$now . \")\") }\n    } else={\n      \$send e=\"modem_fw_recovery_reboot\" l=\"critical\" m=(\$lif . \": LTE still down after interface reset, rebooting once\")\n      :delay 5s\n      /system reboot\n    }\n  }\n}\n"
/system scheduler add name=schedule_MODEM_FW comment="modem firmware (LTE)" interval=7d start-date=PLACEHOLDER_MODEM_FW_START_DATE start-time=PLACEHOLDER_MODEM_FW_START_TIME on-event="/system script run script_MODEM_FW" policy=ftp,reboot,read,write,policy,test,sensitive
:log info "modules/lte/modem-firmware installed (weekly)"
